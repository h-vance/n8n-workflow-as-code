# Local-only n8n owner account for the dev stack in docker-compose.yml.
# Not a real third-party account -- used only to unlock the local REST API
# for n8nac / workflow verification. Copy to .env and fill in.
N8N_OWNER_EMAIL=owner@example.com
N8N_OWNER_PASSWORD=change-me-locally
N8N_OWNER_FIRST_NAME=Harrison
N8N_OWNER_LAST_NAME=Vance

# Optional: Slack incoming-webhook URL. When set, container-incident-responder
# posts its evidence summary to a real channel; when empty, it stays mocked.
SLACK_WEBHOOK_URL=
