                    "leftValue": "",
                    "typeValidation": "loose"
                  },
                  "conditions": [
                    {
                      "id": "cond-protocol",
                      "leftValue": "={{ $json.service_name }}",
                      "rightValue": "node",
                      "operator": {
                        "type": "string",
                        "operation": "contains"
                      }
                    }
                  ],
                  "combinator": "and"
                },
                "renameOutput": true,
                "outputKey": "protocol"
              },
              {
                "conditions": {
                  "options": {
                    "caseSensitive": false,
                    "leftValue": "",
                    "typeValidation": "loose"
                  },
                  "conditions": [
                    {
                      "id": "cond-infra",
                      "leftValue": "={{ $json.service_name }}",
                      "rightValue": "api",
                      "operator": {
                        "type": "string",
                        "operation": "contains"
