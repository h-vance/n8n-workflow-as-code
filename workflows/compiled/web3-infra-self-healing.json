        "name": "Normalize Incident Context",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          -460,
          300
        ],
        "parameters": {
          "mode": "manual",
          "assignments": {
            "assignments": [
              {
                "id": "n1",
                "name": "incident_id",
                "type": "string",
                "value": "={{ ($json.body || $json).incident_id || ($json.body || $json).alert_id || ('ALERT-' + Date.now()) }}"
              },
              {
                "id": "n2",
