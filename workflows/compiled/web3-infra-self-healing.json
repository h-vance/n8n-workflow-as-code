        ],
        "parameters": {
          "content": "**Mocked posting.** The evidence summary text is real (built from the actual run's data); posting it to Jira/Slack is recorded, not executed -- same rationale as escalation-autopsy's mocked legs.",
          "height": 160,
          "width": 480,
          "color": 5
        }
      },
