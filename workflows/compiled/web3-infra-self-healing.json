                "type": "string",
                "value": "={{ ($json.body || $json).symptom || ($json.body || $json).description || \"no symptom provided\" }}"
              }
            ]
          },
          "includeOtherFields": false,
          "options": {}
        }
      },
      {
        "id": "29bacae6-14ef-4213-80f3-f70a03c1151b",
        "name": "Route by Failure Type",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 3.2,
        "position": [
          -220,
          300
