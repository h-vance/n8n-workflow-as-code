      },
      {
        "id": "a8df539f-22b7-4459-81ee-d88995ac5351",
        "name": "Execute Self-Healing",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1260,
          300
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "\nconst item = $input.item.json;\nconst action = item.diagnostic_path === 'protocol'\n  ? 'RPC resync triggered, peer table refreshed'\n  : 'Rolling restart executed on affected pods';\nreturn [{ json: { ...item, remediation_action: action, remediation_status: 'completed' } }];\n"
        }
      },
      {
        "id": "0876a250-71cd-494d-9b82-ce1b95e50409",
        "name": "Evidence Note",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          1500,
